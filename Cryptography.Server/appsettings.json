{
  "Database": {
    "Path": "App_Data/server.db"
  },
  "Authentication": {
    "SessionHours": 12,
    "PasswordIterations": 220000,
    "PermitLimit": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
